# Copy to script/h2/mainnet.env (gitignored), fill in, then `source` it.
# H2 on MegaETH mainnet (4326): settled in USDm, market token = canonical WBTC, one BTC market.
# Run script/h2/mainnet-deploy.sh, not the forge commands by hand.
# Before changing a value read src/h2/DEPLOY_RULES.md; mainnet-deploy.sh prints a PASS/WARN table
# for those rules (script/h2/CheckH2Rules.s.sol, warn-only) against the exact params it deploys.

# --- transport + signer (never commit) ---
export RPC_4326=https://mainnet.megaeth.com/rpc        # public endpoint
# The deployer is a HARDWARE WALLET. H2 has no owner, but the broadcaster is the
# market `creator` and holds the non-transferable seed LP shares (the only party who can pull the
# seed at wind-down), so it must be the cold wallet. It needs BOOTSTRAP_USDM x markets + ~0.002 ETH.
# Device: Ethereum app open, blind signing ON (contract creation, chain id 4326 is unknown to it);
# step 2 = 3 + 3/market txs, each confirmed on the device.
export DEPLOYER_SIGNER=trezor                           # ledger | trezor | key (key = DEPLOYER_KEY, testing only)
export DEPLOYER_ADDR=0x<hardware wallet address>
export DEPLOYER_HD_PATH="m/44'/60'/0'/0/0"              # first account; change if you use another

# --- settlement + market tokens ---
# USDm = MegaUSD, 18 dec, docs.megaeth.com/developer-docs/overview-1/contracts. Verified on chain
# 2026-10-16: symbol USDm, decimals 18, plain transfer (no fee, not rebasing, no paused()).
# It is an upgradeable proxy (xUSDOFTUpgradeable, owner 0x141C…53cb2) WITH an issuer blacklist:
# a blacklisted H2Market would freeze the vault — issuer risk, noted in the deploy record.
export USDM=0xFAfDdbb3FC7688494971a79cc65DCa3EF82079E7
# Market token is IDENTITY ONLY (H2Market never transfers it; decimals irrelevant). Canonical
# WBTC on 4326 (8 dec). Alternatives on the same docs page: BTC.b 0xB0F7…7072, LBTC 0xecAc…11c1.
export MARKET_TOKENS=0x32090fB1399a31cC095e6341a6353b7c09ba84FB
# Per-vault first-LP deposit in USDm wei. NOT minted any more: the deployer must HOLD
# BOOTSTRAP_USDM x (number of markets) before --broadcast (preflight checks the balance).
export BOOTSTRAP_USDM=                                  # launch: 1000000000000000000000 = 1,000 USDm (>= maxOISkew x 10%); rule 2: seed at creation, keep until wind-down

# --- feeds + ticks (DeployH2Mainnet.s.sol) ---
# RedStone Bolt BTC/USD on 4326 (real; 8 dec; updatedAt in microseconds, normalised by the contracts)
export FALLBACK_FEEDS=0xf0DEbDAE819b354D076b0D162e399BE013A856d3
export PRICE_TICKS=1000000000000000000                 # $1
export SIZE_TICKS=10000000000                          # 1e-8 BTC
export OPERATOR=0x159B0e603c58899F53a0633fc37F3167b6AB6F39   # feed operator / rake recipient (pushes marks)

# --- optional (defaults shown in DeployH2Mainnet.s.sol) ---
# export REF_FEEDS=<same shape as FALLBACK_FEEDS>
# export BUILDER_REGISTRY=0                    # 0 = builder codes off; unset = deploy reference registry
# export BUILDER_STAKE_TOKEN=0x<MEGA>          # default 0 = native ETH stake
# export BUILDER_MIN_STAKE=10000000000000000   # 0.01 in stake-token wei
# export MAX_DEVIATION_PPM=10000
# export FALLBACK_MAX_AGE=60
# export MAX_SPREAD_PPM=5000

